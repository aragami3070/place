# Скопируй в .env (в git не попадает). Docker: подхватывается через env_file.
# Локально: node --env-file=.env app.js
# длинная случайная строка, обязательно
SECRET=
# публичный URL СО СХЕМОЙ и портом, если он не стандартный: http://localhost:3000 или https://place.example.edu
# из него строится Redirect URI для OpenID: <HOST>/auth/openid/callback
HOST=
# порт, на котором Place слушает (в docker-compose пробрасывается на 127.0.0.1)
PORT=3000
# на каком адресе хоста открыть порт: 127.0.0.1 (только эта машина) или 0.0.0.0 (вся сеть)
BIND_ADDR=127.0.0.1
DATABASE=mongodb://localhost/place

# --- Вузовский LDAP (Active Directory). Все значения - только здесь ---
LDAP_ENABLED=true
# ldaps://<хост>:636 (или ldap://<хост>:389)
LDAP_URL=
# Шаблон bind, {user} = логин. Для AD обычно UPN: {user}@<домен>
# База поиска: DC=...,DC=...
LDAP_BIND_DN_TEMPLATE=
LDAP_SEARCH_BASE_DN=
LDAP_LOGIN_ATTRIBUTE=sAMAccountName
# Необязательно: пускать только членов этой группы
# Необязательно: роли Place по группам (выдаются и отзываются при каждом входе)
LDAP_REQUIRED_GROUP_DN=
LDAP_ADMIN_GROUP_DN=
LDAP_MODERATOR_GROUP_DN=
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_TIMEOUT_MS=8000

# --- OpenID Connect (можно вместе с LDAP). Redirect URI у провайдера: <HOST>/auth/openid/callback ---
OPENID_ENABLED=false
# URL провайдера, у которого есть /.well-known/openid-configuration
OPENID_ISSUER=
OPENID_CLIENT_ID=
OPENID_CLIENT_SECRET=
OPENID_SCOPES=openid profile email
OPENID_USERNAME_CLAIM=preferred_username
OPENID_GROUPS_CLAIM=groups
# Необязательно: доступ и роли по группам (значения в claim групп)
OPENID_REQUIRED_GROUP=
OPENID_ADMIN_GROUP=
OPENID_MODERATOR_GROUP=
# true: тот же человек из LDAP и OpenID = один аккаунт (только если логин у провайдеров одинаковый)
OPENID_LINK_TO_LDAP=false
OPENID_BUTTON_LABEL=Sign in with OpenID
